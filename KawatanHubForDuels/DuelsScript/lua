loadstring(game:HttpGet("https://pastefy.app/gBpO0gpe/raw"))()
local load = Instance.new("Frame", gui)
load.Size = UDim2.new(1,0,1,0)
load.BackgroundTransparency = 1

-- small center box
local box = Instance.new("Frame", load)
box.Size = UDim2.new(0,260,0,90)
box.Position = UDim2.new(0.5,-130,0.5,-45)
box.BackgroundColor3 = Color3.fromRGB(0,200,255) -- SKY BLUE
box.BorderSizePixel = 0

-- rounded look (optional clean)
local corner = Instance.new("UICorner", box)
corner.CornerRadius = UDim.new(0,10)

-- title
local txt = Instance.new("TextLabel", box)
txt.Size = UDim2.new(1,0,0.6,0)
txt.BackgroundTransparency = 1
txt.Text = "Kawatan Hub"
txt.TextScaled = true
txt.TextColor3 = Color3.new(1,1,1)

-- progress bar background
local barBG = Instance.new("Frame", box)
barBG.Size = UDim2.new(0.85,0,0,6)
barBG.Position = UDim2.new(0.075,0,0.7,0)
barBG.BackgroundColor3 = Color3.fromRGB(180,180,180)
barBG.BorderSizePixel = 0

local barCorner = Instance.new("UICorner", barBG)
barCorner.CornerRadius = UDim.new(1,0)

-- progress bar
local bar = Instance.new("Frame", barBG)
bar.Size = UDim2.new(0,0,1,0)
bar.BackgroundColor3 = Color3.fromRGB(255,255,255)
bar.BorderSizePixel = 0

local barCorner2 = Instance.new("UICorner", bar)
barCorner2.CornerRadius = UDim.new(1,0)

-- 15 seconds smooth loading
local totalTime = 15
local steps = 150

for i = 1, steps do
	bar.Size = UDim2.new(i/steps,0,1,0)
	task.wait(totalTime/steps)
end

-- fade out
for i = 1,10 do
	box.BackgroundTransparency += 0.1
	txt.TextTransparency += 0.1
	bar.BackgroundTransparency += 0.1
	barBG.BackgroundTransparency += 0.1
	task.wait(0.05)
end

load:Destroy()
